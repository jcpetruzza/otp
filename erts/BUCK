load("@otp//buck2:defs.bzl", "CFLAGS")
load("@otp//buck2/autotools:defs.bzl", "configure")

configure(
    name = "config",
    script = "configure",
    srcs = [
        "config.h.in",
        "include/erl_int_sizes_config.h.in",
        "include/internal/ethread_header_config.h.in",
    ],
)

cxx_library(
    name = "common",
    srcs = glob(["lib_src/common/*.c"]) + select({
        "config//os:windows": glob(["lib_src/win/*.c"]),
        "DEFAULT": glob(["lib_src/pthread/*.c"]),
    }),
    exported_headers = dict(
        [
            ("config.h", ":config[config.h]"),
            ("erl_int_sizes_config.h", ":config[include/erl_int_sizes_config.h]"),
            ("ethread_header_config.h", ":config[include/internal/ethread_header_config.h]"),
        ] + [
            (h.removeprefix("include/internal/"), h)
            for h in glob(["include/internal/**/*.h"])
        ]),
    header_namespace = "",
    compiler_flags = CFLAGS,
    visibility = ["PUBLIC"],
    link_style = "static",
)
