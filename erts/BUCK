load("@otp//buck2/autotools:defs.bzl", "configure")
load("@otp//buck2/cxx.bzl", "strip_include_prefix")
load("@otp//buck2/codegen:defs.bzl", "erl_version")

configure(
    name = "config",
    script = "configure",
    srcs = {
        "": [
            "otp//:OTP_VERSION",
        ],
        "erts": [
            "config.h.in",
            "include/erl_int_sizes_config.h.in",
            "include/internal/ethread_header_config.h.in",
            ],
        "make": [
            "otp//make:otp.mk.in",
            "otp//make:autoconf/config.sub",
        ],
    },
)

erl_version(
    name = "erl_version.h",
    otp = ":config[make/otp.mk]",
    vsn = "vsn.mk",
    visibility = ["PUBLIC"],
)

cxx_library(
    name = "headers",
    exported_headers = (
        {
            "config.h": ":config[erts/config.h]",
            "erl_int_sizes_config.h": ":config[erts/include/erl_int_sizes_config.h]",
            "ethread_header_config.h": ":config[erts/include/internal/ethread_header_config.h]",
        } |
        strip_include_prefix(
            "include/internal/",
            glob([
                "include/internal/*.h",
                "include/internal/gcc/*.h",
                "include/internal/i386/*.h",
                "include/internal/libatomic_ops/*.h",
                "include/internal/ppc32/*.h",
                "include/internal/pthread/*.h",
                "include/internal/tile/*.h",
                "include/internal/win/*.h",
                "include/internal/x86_64/*.h",
            ])
        )
    ),
    header_namespace = "",
    visibility = ["PUBLIC"],
    link_style = "static",
)

cxx_library(
    name = "common",
    srcs = glob(["lib_src/common/*.c"]) + select({
        "config//os:windows": glob(["lib_src/win/*.c"]),
        "DEFAULT": glob(["lib_src/pthread/*.c"]),
    }),
    exported_deps = [":headers"],
    visibility = ["PUBLIC"],
)

cxx_binary(
    name = "yielding_c_fun",
    srcs = glob(["lib_src/yielding_c_fun/*.c"]),
    visibility = ["PUBLIC"],
)
