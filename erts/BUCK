load("@otp//buck2/autotools:defs.bzl", "configure")
load("@otp//buck2/constants.bzl", "OTP_VERSION", "SYSTEM_VSN", "VSN")
load("@otp//buck2/cxx.bzl", "strip_include_prefix")
load("@otp//buck2/codegen:defs.bzl", "erl_version")
load("@otp//buck2/erlang.bzl", "erts_release")

erts_release(
    name = "erts",
    erl = "otp//erts/etc:dyn_erl",
    beam = "otp//erts/emulator:beam",
    bins = [
        "otp//erts/etc:ct_run",
        "otp//erts/etc:dialyzer",
        "otp//erts/epmd:epmd",
        "otp//erts/etc:erlc",
        "otp//lib/erl_interface:erl_call",
        "otp//erts/etc:escript",
        "otp//erts/etc:run_erl",
        "otp//erts/etc:to_erl",
        "otp//erts/etc:typer",
    ],
    internal_bins = [
        "otp//erts/etc:erlexec",
        "otp//erts/etc:heart",
        "otp//erts/etc:inet_gethost",
        "otp//erts/emulator:erl_child_setup",
        ":yielding_c_fun",
    ],
    visibility = ["PUBLIC"],
)

configure(
    name = "config",
    script = "configure",
    srcs = {
        "erts": [
            "config.h.in",
            "include/erl_int_sizes_config.h.in",
            "include/internal/ethread_header_config.h.in",
            ],
        "make": [
            "otp//make:autoconf/config.sub",
        ],
    },
)

alias(
    name = "config.h",
    actual = ":config[erts/config.h]",
    visibility = ["PUBLIC"],
)

erl_version(
    name = "erl_version.h",
    otp_version = OTP_VERSION,
    system_vsn = SYSTEM_VSN,
    vsn = VSN,
    visibility = ["PUBLIC"],
)

cxx_library(
    name = "headers",
    exported_headers = (
        {
            "config.h": ":config.h",
            "erl_int_sizes_config.h": ":config[erts/include/erl_int_sizes_config.h]",
            "ethread_header_config.h": ":config[erts/include/internal/ethread_header_config.h]",
        } |
        strip_include_prefix(
            "include/internal/",
            glob([
                "include/internal/*.h",
                "include/internal/gcc/*.h",
                "include/internal/i386/*.h",
                "include/internal/libatomic_ops/*.h",
                "include/internal/ppc32/*.h",
                "include/internal/pthread/*.h",
                "include/internal/tile/*.h",
                "include/internal/win/*.h",
                "include/internal/x86_64/*.h",
            ])
        )
    ),
    header_namespace = "",
    visibility = ["PUBLIC"],
    link_style = "static",
)

cxx_library(
    name = "common",
    srcs = glob(["lib_src/common/*.c"]) + select({
        "config//os:windows": glob(["lib_src/win/*.c"]),
        "DEFAULT": glob(["lib_src/pthread/*.c"]),
    }),
    exported_deps = [":headers"],
    visibility = ["PUBLIC"],
)

cxx_binary(
    name = "yielding_c_fun",
    srcs = glob(["lib_src/yielding_c_fun/*.c"]),
    visibility = ["PUBLIC"],
)
