    name = "start_sasl",
    src = "start_sasl.rel.src",
    erl_opts = [],
    versions = _VERSIONS,
    visibility = ["PUBLIC"],
)

boot_script(
    name = "no_dot_erlang",
    src = "no_dot_erlang.rel.src",
    erl_opts = [
