        flatten_includes(glob([
            "beam/jit/*.h",
            "beam/jit/*.hpp",
            "beam/jit/x86/*.hpp"
        ])),
       {"beam_asm_global.hpp": ":beam/jit/x86/beam_asm_global.hpp"},
    ),
    header_namespace = "",
    deps = [
        ":headers",
        "@otp//erts/emulator/asmjit:lib",
