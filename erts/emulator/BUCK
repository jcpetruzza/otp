    compiler_flags = ASMJIT_FLAGS,
    target_compatible_with = [
        "config//cpu:x86_64",
        "otp//buck2/constraints/emu_flavor:jit",
    ],
    modifiers = [
        "otp//buck2/constraints/emu_flavor:jit",
    ],
    link_style = "static",
)

