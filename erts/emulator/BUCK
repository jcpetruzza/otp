)

cxx_library(
    name = "headers",
    exported_deps = [
        "otp//erts:headers",
        "otp//erts/emulator/openssl:headers",
    ],
    exported_headers = headers_union(
        flatten_includes(
            glob([
                "sys/common/*.h",
                "sys/unix/*.h",
                "beam/jit/beam_asm.h",
            ]),
        ),
        strip_include_prefix(
            "beam/",
            glob([
                "beam/*.h",
                "beam/jit/*.h",
            ])
        ),
        {
            "erl_alloc_types.h": ":alloc_types[erl_alloc_types.h]",
            "erl_atom_table.h": ":tables[erl_atom_table.h]",
            "erl_bif_table.h": ":tables[erl_bif_table.h]",
            "erl_version.h": "otp//erts:erl_version.h",

            "erl_db_insert_list.ycf.h": ":erl_db_insert_list.ycf.h",
            "erl_map.ycf.h": ":erl_map.ycf.h",
            "utils.ycf.h": ":utils.ycf.h",
        },
        select({
            "otp//buck2/config/emu_flavor:emu": {
                "beam_opcodes.h": ":opcodes-emu[beam_opcodes.h]",
                "beam_cold.h": ":opcodes-emu[beam_cold.h]",
                "beam_warm.h": ":opcodes-emu[beam_warm.h]",
                "beam_hot.h": ":opcodes-emu[beam_hot.h]",
            },

            "otp//buck2/config/emu_flavor:jit": {
                "beam_opcodes.h": ":opcodes-jit[beam_opcodes.h]",
                "beamasm_emit.h": ":opcodes-jit[beamasm_emit.h]",
                "beamasm_protos.h": ":opcodes-jit[beamasm_protos.h]",
            }
        })
    ),
    header_namespace = "",
    visibility = ["PUBLIC"],
)

cxx_binary(
    name = "erl_child_setup",
    srcs = [
        "beam/hash.c",
        "sys/unix/erl_child_setup.c",
        "sys/unix/sys_uds.c",
    ],
    deps = [
        ":headers"
    ],
    visibility = ["PUBLIC"],
)

genrule(
    name = "erl_poll.flbk.c",
    cmd = """
    echo '#define ERTS_NO_KERNEL_POLL_VERSION"' > $OUT
    cat $SRCS >> $OUT
    """,
    srcs = ["sys/common/erl_poll.c"],
    out = "erl_poll.flbk.c",
)

cxx_library(
    name = "sys",
    srcs = glob(["sys/common/*.c", "sys/unix/*.c"], exclude = [
        "sys/unix/erl_child_setup.c",
        "sys/unix/erl_main.c",
    ]) + [
        ":erl_poll.flbk.c",
    ],
    deps = [
        ":headers",
        "otp//erts:common",
    ],
    link_style = "static",
)

