load("@otp//buck2:erlang.bzl", "erlang_otp_release")
load("@otp//buck2/tests:defs.bzl", "otp_tests")
load("@toolchains//erlang:defs.bzl", "COMMON_ERL_OPTS")
load(":defs.bzl", "test_variants", "resources_for")

VARIANTS_CONFIG = {
    "andor_SUITE": test_variants.common +[test_variants.inline, test_variants.no_bool_opt],
    "apply_SUITE": test_variants.common + [test_variants.inline],
    "beam_block_SUITE": test_variants.common + [test_variants.inline],
    "beam_except_SUITE": test_variants.common,
    "beam_jump_SUITE": test_variants.common,
    "beam_reorder_SUITE": test_variants.common,
    "beam_ssa_SUITE": test_variants.common + [test_variants.inline],
    "beam_type_SUITE": test_variants.common,
    "beam_utils_SUITE": test_variants.common + [test_variants.inline],
    "bif_SUITE": test_variants.common + [test_variants.inline],
    "bs_bincomp_SUITE": test_variants.common + [test_variants.inline, test_variants.r26],
    "bs_bit_binaries_SUITE": [test_variants.inline],
    "bs_construct_SUITE": test_variants.common + [test_variants.inline, test_variants.r26],
    "bs_match_SUITE": test_variants.common + [test_variants.dialyzer, test_variants.inline, test_variants.r26],
    "bs_size_expr_SUITE": test_variants.common + [test_variants.inline],
    "bs_utf_SUITE": test_variants.common + [test_variants.inline, test_variants.r26],
    "core_fold_SUITE": test_variants.common + [test_variants.inline],
    "float_SUITE": test_variants.common + [test_variants.inline],
    "fun_SUITE": test_variants.common + [test_variants.inline],
    "guard_SUITE": test_variants.common + [test_variants.inline, test_variants.no_bool_opt],
    "lc_SUITE": test_variants.common + [test_variants.inline],
    "map_SUITE": test_variants.common + [test_variants.inline],
    "match_SUITE": test_variants.common + [test_variants.inline],
    "maybe_SUITE": test_variants.common + [test_variants.inline],
    "mc_SUITE": test_variants.common + [test_variants.inline],
    "misc_SUITE": test_variants.common + [test_variants.inline],
    "overridden_bif_SUITE": test_variants.common + [test_variants.inline],
    "receive_SUITE": test_variants.common + [test_variants.inline],
    "record_SUITE": test_variants.common + [test_variants.inline],
    "trycatch_SUITE": test_variants.common,
    "zlc_SUITE": test_variants.common,
}

TESTING_ERL_OPTS = COMMON_ERL_OPTS + [
    "+clint",
    "+clint0",
    "+ssalint",
    "+nowarn_missing_spec_documented",
]

otp_tests(
    name = "tests",
    suites =  glob(
        ["*_SUITE.erl"],
        # these can be generated by Make
        exclude = test_variants.makefile_variants(VARIANTS_CONFIG),
    ),
    erl_opts = TESTING_ERL_OPTS,
    deps = [
        ":test-support",
    ],
    overrides = {
        "beam_types_SUITE.erl": {
            "patch": """
                sed -e 's#-include_lib("compiler/src/beam_types.hrl").#-include_lib("test-support/include/beam_types.hrl").#'
            """,
        },
        "beam_validator_SUITE.erl": {
            "deps": [
                ":beam_utils_SUITE",
                ":bs_match_SUITE",
                ":bs_bincomp_SUITE",
                ":bs_bit_binaries_SUITE",
                ":bs_utf_SUITE",
            ],
        },
    },

    # Reduce number of compilations needed
    modifiers = [ "otp//buck2/constraints/erlang_toolchain:compiler-testing" ],
)

[
    test_variants.gen_variant(
        name=variant + ".erl",
        src=base_suite + ".erl",
    )
    for variant in test_variants.all
    for variant, base_suite in test_variants.suites_for(variant, VARIANTS_CONFIG).items()
]

[
    otp_tests(
        name = test_variants.variant_group_name(variant),
        suites = [
            ":" + suite + ".erl"
            for suite in variant_suites
        ],
        erl_opts = test_variants.erl_opts(variant) + TESTING_ERL_OPTS,
        deps = [
            ":test-support",
        ],

        overrides = {
            (":" + suite + ".erl"): {"resources": resources_for(base_suite + ".erl")}
            for suite, base_suite in variant_suites.items()
        },

        # Reduce number of compilations needed
        modifiers = [ "otp//buck2/constraints/erlang_toolchain:compiler-testing" ],
    )
    for variant in test_variants.all
    for variant_suites in [test_variants.suites_for(variant, VARIANTS_CONFIG)]
]

# TODO: erlang_test() unable to process erlang core:
#  * "lfe_andor_SUITE.core"
#  * "lfe_guard_SUITE.core"

erlang_application(
    name = "test-support",
    srcs = ["test_lib.erl"],
    includes = [
        "otp//lib/compiler:opcodes[beam_opcodes.hrl]",
        "otp//lib/compiler:src/beam_types.hrl",
    ],
)

# We use a custom toolchain for testing, to reduce recompilations
# when the compiler changes
erlang_otp_release(
    name = "testing-toolchain",
    erts = "otp//erts:erts",
    boots = [
        "otp//bootstrap:bin/start.boot",
        "otp//bootstrap:bin/no_dot_erlang.boot",
    ],
    extends = "otp//bootstrap:bootstrap-2",
    bootstrapping = True,
    apps = [
        "otp//lib/crypto:app",
        "otp//lib/runtime_tools:app",
        "otp//lib/tools:app",
    ],
    incoming_transition = "otp//bootstrap:use-bootstrap-2",
    visibility = ["PUBLIC"],
)
